{
  "info": {
    "name": "api-gateway",
    "description": "Buoi 4 end-to-end checks through API Gateway only. Start auth-service, course-service, registration-service, and api-gateway, then run the whole collection in order. Example: newman run postman/CRS-Microservices.postman_collection.json. Each run creates unique data and performs the available cleanup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "partnerApiKey", "value": "crs-partner-key-2026" },
    { "key": "runId", "value": "" },
    { "key": "courseName", "value": "" },
    { "key": "updatedCourseName", "value": "" },
    { "key": "studentId", "value": "" },
    { "key": "secondStudentId", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "studentToken", "value": "" },
    { "key": "createdCourseId", "value": "" },
    { "key": "createdRegistrationId", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Core 1 - Login admin",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const runId = Date.now() + '-' + Math.floor(Math.random() * 1000000);",
              "const studentId = Date.now() + Math.floor(Math.random() * 1000);",
              "pm.collectionVariables.set('runId', runId);",
              "pm.collectionVariables.set('courseName', 'Buoi 4 Newman ' + runId);",
              "pm.collectionVariables.set('updatedCourseName', 'Buoi 4 Newman Updated ' + runId);",
              "pm.collectionVariables.set('studentId', studentId);",
              "pm.collectionVariables.set('secondStudentId', studentId + 1);",
              "pm.collectionVariables.unset('adminToken');",
              "pm.collectionVariables.unset('studentToken');",
              "pm.collectionVariables.unset('createdCourseId');",
              "pm.collectionVariables.unset('createdRegistrationId');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Core 1: admin login returns HTTP 200', () => pm.response.to.have.status(200));",
              "let body = null;",
              "try { body = pm.response.json(); } catch (error) {}",
              "pm.test('Login response identifies ADMIN and contains a JWT', () => {",
              "  pm.expect(body).to.be.an('object');",
              "  pm.expect(body.username).to.eql('admin');",
              "  pm.expect(body.role).to.eql('ADMIN');",
              "  pm.expect(body.token).to.be.a('string');",
              "  pm.expect(body.token.length).to.be.above(20);",
              "});",
              "if (pm.response.code === 200 && body && typeof body.token === 'string') {",
              "  pm.collectionVariables.set('adminToken', body.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "02 - Required - Login student",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Student login returns HTTP 200', () => pm.response.to.have.status(200));",
              "let body = null;",
              "try { body = pm.response.json(); } catch (error) {}",
              "pm.test('Login response identifies STUDENT and contains a JWT', () => {",
              "  pm.expect(body).to.be.an('object');",
              "  pm.expect(body.username).to.eql('student1');",
              "  pm.expect(body.role).to.eql('STUDENT');",
              "  pm.expect(body.token).to.be.a('string');",
              "  pm.expect(body.token.length).to.be.above(20);",
              "});",
              "if (pm.response.code === 200 && body && typeof body.token === 'string') {",
              "  pm.collectionVariables.set('studentToken', body.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"student1\",\n  \"password\": \"student123\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "03 - Core 2 - Public course list without JWT",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Core 2: public course list returns HTTP 200', () => pm.response.to.have.status(200));",
              "let body = null;",
              "try { body = pm.response.json(); } catch (error) {}",
              "pm.test('Course response is a pageable list', () => {",
              "  pm.expect(body).to.be.an('object');",
              "  pm.expect(body.content).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/courses?page=0&size=10&sort=tenMonHoc,asc"
      }
    },
    {
      "name": "04 - Core 3 - Gateway rejects missing Authorization",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Core 3: protected write without Authorization returns HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenMonHoc\": \"No Auth {{runId}}\",\n  \"soTinChi\": 3,\n  \"soChoToiDa\": 30\n}"
        },
        "url": "{{baseUrl}}/api/courses"
      }
    },
    {
      "name": "05 - Core 4 - Course service rejects STUDENT write",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Core 4: STUDENT cannot create a course (HTTP 403)', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{studentToken}}", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenMonHoc\": \"Student Forbidden {{runId}}\",\n  \"soTinChi\": 3,\n  \"soChoToiDa\": 30\n}"
        },
        "url": "{{baseUrl}}/api/courses"
      }
    },
    {
      "name": "06 - Core 5 - ADMIN creates a unique course",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Core 5: ADMIN creates a course (HTTP 201)', () => pm.response.to.have.status(201));",
              "let body = null;",
              "try { body = pm.response.json(); } catch (error) {}",
              "pm.test('Created course has the requested values and one available seat', () => {",
              "  pm.expect(body).to.be.an('object');",
              "  pm.expect(Number(body.id)).to.be.above(0);",
              "  pm.expect(body.tenMonHoc).to.eql(pm.collectionVariables.get('courseName'));",
              "  pm.expect(body.soTinChi).to.eql(3);",
              "  pm.expect(body.soChoToiDa).to.eql(1);",
              "  pm.expect(body.soChoConLai).to.eql(1);",
              "});",
              "if (pm.response.code === 201 && body && body.id) {",
              "  pm.collectionVariables.set('createdCourseId', body.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenMonHoc\": \"{{courseName}}\",\n  \"soTinChi\": 3,\n  \"soChoToiDa\": 1\n}"
        },
        "url": "{{baseUrl}}/api/courses"
      }
    },
    {
      "name": "07 - Extra - ADMIN updates the created course through Gateway",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('ADMIN update returns HTTP 200', () => pm.response.to.have.status(200));",
              "let body = null;",
              "try { body = pm.response.json(); } catch (error) {}",
              "pm.test('Updated course contains the new name and credit count', () => {",
              "  pm.expect(body).to.be.an('object');",
              "  pm.expect(Number(body.id)).to.eql(Number(pm.collectionVariables.get('createdCourseId')));",
              "  pm.expect(body.tenMonHoc).to.eql(pm.collectionVariables.get('updatedCourseName'));",
              "  pm.expect(body.soTinChi).to.eql(4);",
              "  pm.expect(body.soChoToiDa).to.eql(1);",
              "  pm.expect(body.soChoConLai).to.eql(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenMonHoc\": \"{{updatedCourseName}}\",\n  \"soTinChi\": 4,\n  \"soChoToiDa\": 1\n}"
        },
        "url": "{{baseUrl}}/api/courses/{{createdCourseId}}"
      }
    },
    {
      "name": "08 - Core 6 - STUDENT registers the created course",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Core 6: STUDENT registration returns HTTP 201', () => pm.response.to.have.status(201));",
              "let body = null;",
              "try { body = pm.response.json(); } catch (error) {}",
              "pm.test('Registration links the dynamic student and course IDs', () => {",
              "  pm.expect(body).to.be.an('object');",
              "  pm.expect(Number(body.id)).to.be.above(0);",
              "  pm.expect(Number(body.studentId)).to.eql(Number(pm.collectionVariables.get('studentId')));",
              "  pm.expect(Number(body.courseId)).to.eql(Number(pm.collectionVariables.get('createdCourseId')));",
              "  pm.expect(body.trangThai).to.eql('DA_DANG_KY');",
              "});",
              "if (pm.response.code === 201 && body && body.id) {",
              "  pm.collectionVariables.set('createdRegistrationId', body.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{studentToken}}", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentId\": {{studentId}},\n  \"courseId\": {{createdCourseId}}\n}"
        },
        "url": "{{baseUrl}}/api/registrations"
      }
    },
    {
      "name": "09 - Extra - Registration reserves the last seat",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Created course remains readable (HTTP 200)', () => pm.response.to.have.status(200));",
              "let body = null;",
              "try { body = pm.response.json(); } catch (error) {}",
              "pm.test('Remaining seats decreased from one to zero', () => {",
              "  pm.expect(body).to.be.an('object');",
              "  pm.expect(Number(body.id)).to.eql(Number(pm.collectionVariables.get('createdCourseId')));",
              "  pm.expect(body.soChoConLai).to.eql(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/courses/{{createdCourseId}}"
      }
    },
    {
      "name": "10 - Extra - Duplicate registration is rejected",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Duplicate active registration returns HTTP 409', () => pm.response.to.have.status(409));",
              "let body = null;",
              "try { body = pm.response.json(); } catch (error) {}",
              "pm.test('Duplicate error explains the conflict', () => {",
              "  pm.expect(body).to.be.an('object');",
              "  pm.expect(body.message).to.eql('Sinh vien da dang ky mon hoc nay roi');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{studentToken}}", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentId\": {{studentId}},\n  \"courseId\": {{createdCourseId}}\n}"
        },
        "url": "{{baseUrl}}/api/registrations"
      }
    },
    {
      "name": "11 - Extra - Sold-out course is rejected",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('A second student cannot take a sold-out course (HTTP 409)', () => pm.response.to.have.status(409));",
              "let body = null;",
              "try { body = pm.response.json(); } catch (error) {}",
              "pm.test('Sold-out error is propagated by registration-service', () => {",
              "  pm.expect(body).to.be.an('object');",
              "  pm.expect(body.message).to.eql('Mon hoc da het cho');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{studentToken}}", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentId\": {{secondStudentId}},\n  \"courseId\": {{createdCourseId}}\n}"
        },
        "url": "{{baseUrl}}/api/registrations"
      }
    },
    {
      "name": "12 - Extra - Registration service rejects an invalid JWT",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Invalid JWT reaches service authentication and returns HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer invalid.jwt.token", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentId\": {{secondStudentId}},\n  \"courseId\": {{createdCourseId}}\n}"
        },
        "url": "{{baseUrl}}/api/registrations"
      }
    },
    {
      "name": "13 - Core 7 - Partner API accepts the configured key",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Core 7: partner route with X-API-KEY returns HTTP 200', () => pm.response.to.have.status(200));",
              "let body = null;",
              "try { body = pm.response.json(); } catch (error) {}",
              "pm.test('Partner route returns a pageable course list', () => {",
              "  pm.expect(body).to.be.an('object');",
              "  pm.expect(body.content).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-API-KEY", "value": "{{partnerApiKey}}", "type": "text" }
        ],
        "url": "{{baseUrl}}/api/public/courses?page=0&size=10"
      }
    },
    {
      "name": "14 - Core 8a - Partner API rejects a wrong key",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Core 8a: wrong X-API-KEY returns HTTP 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-API-KEY", "value": "wrong-key", "type": "text" }
        ],
        "url": "{{baseUrl}}/api/public/courses"
      }
    },
    {
      "name": "15 - Core 8b - Partner API rejects a missing key",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Core 8b: missing X-API-KEY returns HTTP 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/public/courses"
      }
    },
    {
      "name": "16 - Extra - Internal course API is not exposed by Gateway",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Gateway has no public route for the internal endpoint (HTTP 404)', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }
        ],
        "url": "{{baseUrl}}/internal/courses/{{createdCourseId}}/reserve-seat"
      }
    },
    {
      "name": "17 - Cleanup - STUDENT cancels the registration",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Cleanup cancellation returns HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{studentToken}}", "type": "text" }
        ],
        "url": "{{baseUrl}}/api/registrations/{{createdRegistrationId}}"
      }
    },
    {
      "name": "18 - Cleanup - Cancellation releases the seat",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Course remains readable after cancellation (HTTP 200)', () => pm.response.to.have.status(200));",
              "let body = null;",
              "try { body = pm.response.json(); } catch (error) {}",
              "pm.test('Cancellation restored the available seat', () => {",
              "  pm.expect(body).to.be.an('object');",
              "  pm.expect(body.soChoConLai).to.eql(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/courses/{{createdCourseId}}"
      }
    },
    {
      "name": "19 - Cleanup - ADMIN removes the test course",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Cleanup course deletion returns HTTP 204', () => pm.response.to.have.status(204));",
              "if (pm.response.code === 204) {",
              "  pm.collectionVariables.unset('adminToken');",
              "  pm.collectionVariables.unset('studentToken');",
              "  pm.collectionVariables.unset('createdCourseId');",
              "  pm.collectionVariables.unset('createdRegistrationId');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }
        ],
        "url": "{{baseUrl}}/api/courses/{{createdCourseId}}"
      }
    }
  ]
}
